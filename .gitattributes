# Auto detect text files and perform LF normalization
* text=auto

# Standard Python files
*.py text eol=lf
*.pyw text eol=lf

# Configuration and scripts
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.toml text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Documentation and text files
*.csv text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Force binary for databases and media
*.db binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
